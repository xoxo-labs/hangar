node_modules/
dist/
dist-electron/
apps/desktop/release/
.DS_Store
*.log
.tmp/

# Signing material must never reach a public repo: the .p12 export password
# and any certificate that happens to be staged here while setting up secrets.
.hiddenPassword
*.p12

# Xcode (regenerate with `pnpm --filter @hangar/desktop appintents:project`)
apps/desktop/appintents/HangarIntents.xcodeproj/
apps/desktop/appintents/DevHost/Info.plist
# xcodegen writes the appex plist and entitlements next to the fragment that
# declares them; the fragment itself is generated code and is committed.
apps/desktop/appintents/Generated/HangarIntents-Info.plist
apps/desktop/appintents/Generated/HangarIntents.entitlements
# xcodebuild's derived data when the packaging hook builds the extension
apps/desktop/appintents/build/
*.tgz
