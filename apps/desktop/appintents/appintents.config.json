{
  "app": { "name": "Hangar" },
  "linking": { "scheme": "hangar" },
  "entities": [
    {
      "name": "Project",
      "title": "Project",
      "identifier": "id",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "name", "type": "string", "title": "Name" },
        { "name": "path", "type": "string", "title": "Path" },
        { "name": "status", "type": "string", "title": "Status" }
      ],
      "display": {
        "title": "name",
        "subtitle": "status",
        "image": { "systemName": "folder" }
      },
      "indexed": true,
      "url": { "path": "project" }
    },
    {
      "name": "Process",
      "title": "Process",
      "identifier": "id",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "name", "type": "string", "title": "Name" },
        { "name": "project", "type": "string", "title": "Project" },
        { "name": "qualifiedName", "type": "string", "title": "Process" },
        { "name": "state", "type": "string", "title": "State" }
      ],
      "display": {
        "title": "qualifiedName",
        "subtitle": "state",
        "image": { "systemName": "terminal" }
      },
      "indexed": false,
      "url": { "path": "process" }
    }
  ],
  "intents": [
    {
      "name": "OpenProject",
      "title": "Open Project",
      "description": "Opens a project in Hangar.",
      "implementationDescription": "Foreground Hangar (launching it if needed) with this project focused in the sidebar. Opening never starts anything — parity with the in-app rule that only ▶ starts a process.",
      "parameters": [
        { "name": "project", "entity": "Project", "requestDialog": "Which project?" }
      ],
      "behavior": { "kind": "openApp", "target": "project" },
      "shortcut": {
        "phrases": ["Open ${project} in ${applicationName}"],
        "shortTitle": "Open Project",
        "systemImageName": "folder"
      }
    },
    {
      "name": "StartProcess",
      "title": "Start Process",
      "description": "Starts a process in Hangar.",
      "implementationDescription": "Write a start command to the shared command directory. If Hangar is running it picks the command up immediately; otherwise launch Hangar and the command executes once the server is up. The entity query should suggest only stopped processes — starting is the only exposed verb, so a running process has no valid action here.",
      "parameters": [
        { "name": "process", "entity": "Process", "requestDialog": "Which process?" }
      ],
      "behavior": {
        "kind": "dialog",
        "dialog": "Starting ${process.name} in ${process.project}."
      },
      "execution": "background",
      "shortcut": {
        "phrases": ["Start ${process} in ${applicationName}"],
        "shortTitle": "Start Process",
        "systemImageName": "play.fill"
      }
    },
    {
      "name": "StartProject",
      "title": "Start Project",
      "description": "Starts every process in a Hangar project.",
      "implementationDescription": "Same command-directory contract as StartProcess, with a start-all command for the project. Launch Hangar if it is not running.",
      "parameters": [
        { "name": "project", "entity": "Project", "requestDialog": "Which project?" }
      ],
      "behavior": {
        "kind": "dialog",
        "dialog": "Starting all processes in ${project.name}."
      },
      "execution": "background",
      "shortcut": {
        "phrases": ["Start ${project} in ${applicationName}"],
        "shortTitle": "Start Project",
        "systemImageName": "play.circle"
      }
    }
  ]
}
