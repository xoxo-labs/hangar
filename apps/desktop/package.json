{
  "name": "@hangar/desktop",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "build:server": "esbuild ../server/src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server/cli.mjs --external:node-pty --external:ws",
    "build:updater": "esbuild updater.mjs --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist/updater.cjs",
    "build": "rm -rf dist && pnpm --filter @hangar/web build && mkdir -p dist/web && cp -R ../web/dist/. dist/web/ && pnpm build:server && pnpm build:updater",
    "package:mac": "pnpm build && electron-builder --mac dir --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --publish never",
    "release:mac": "pnpm build && electron-builder --mac dmg zip --publish always",
    "appintents:generate": "cd appintents && bun \"${HANGAR_APPINTENTS_CODEGEN:-../../../../voicecraft/packages/appintents-codegen}/src/cli.ts\" appintents.config.json Generated --extension-scaffold IntentsExtension",
    "appintents:project": "cd appintents && xcodegen generate",
    "mock-updates": "node scripts/mock-update-server.mjs",
    "test": "node --test updateReducer.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "works.xoxo.hangar",
    "productName": "Hangar",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "main.mjs",
      "preload.cjs",
      "RELEASE_NOTES.md",
      "dist/**/*",
      "package.json",
      "node_modules/node-pty/**/*",
      "node_modules/ws/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/embed-appintents.mjs",
    "extraResources": [
      {
        "from": "appintents/Generated/store-contract.json",
        "to": "store-contract.json"
      }
    ],
    "protocols": [
      {
        "name": "Hangar",
        "schemes": [
          "hangar"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "signIgnore": [
        "Contents/Extensions/HangarIntents\\.appex"
      ],
      "notarize": true,
      "target": [
        "dir",
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Hangar ${version}",
      "sign": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xoxo-labs",
        "repo": "hangar"
      }
    ]
  }
}
