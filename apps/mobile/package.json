{
  "name": "@hangar/mobile",
  "version": "0.6.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "ipad": "xcrun simctl boot 'iPad Pro 13-inch (M5)' 2>/dev/null; open -a Simulator && expo start --ios",
    "android": "expo start --android",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/*.test.ts"
  },
  "dependencies": {
    "@expo/log-box": "~57.0.2",
    "@expo/metro-runtime": "~57.0.9",
    "@hangar/client-core": "workspace:*",
    "@hangar/contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "anser": "^1.4.10",
    "expo": "~57.0.12",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
